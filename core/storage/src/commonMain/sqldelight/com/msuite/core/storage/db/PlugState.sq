-- Local bookkeeping per backend plug (decision 0036). hlc is sign-flipped as in field_state.
CREATE TABLE ingested_batch (
    plug TEXT NOT NULL,
    batch_key TEXT NOT NULL,
    PRIMARY KEY (plug, batch_key)
) WITHOUT ROWID;

-- A key whose bytes failed to decode: attempts counts the failures, corrupt is set once they run
-- out and the key stops being fetched (decision 0069). The bytes stay in the backend.
CREATE TABLE unreadable_batch (
    plug TEXT NOT NULL,
    batch_key TEXT NOT NULL,
    attempts INTEGER NOT NULL,
    corrupt INTEGER NOT NULL,
    PRIMARY KEY (plug, batch_key)
) WITHOUT ROWID;

CREATE TABLE plug_watermark (
    plug TEXT NOT NULL PRIMARY KEY,
    hlc INTEGER NOT NULL
);

isIngested:
SELECT COUNT(*) > 0 FROM ingested_batch WHERE plug = ? AND batch_key = ?;

markIngested:
INSERT OR IGNORE INTO ingested_batch VALUES (?, ?);

insertUnreadable:
INSERT OR IGNORE INTO unreadable_batch (plug, batch_key, attempts, corrupt) VALUES (?, ?, 1, 0);

bumpUnreadable:
UPDATE unreadable_batch SET attempts = attempts + 1 WHERE plug = ? AND batch_key = ?;

unreadable:
SELECT attempts FROM unreadable_batch WHERE plug = ? AND batch_key = ?;

markCorrupt:
UPDATE unreadable_batch SET corrupt = 1 WHERE plug = ? AND batch_key = ?;

isCorrupt:
SELECT COUNT(*) > 0 FROM unreadable_batch WHERE plug = ? AND batch_key = ? AND corrupt = 1;

watermark:
SELECT hlc FROM plug_watermark WHERE plug = ?;

setWatermark:
INSERT OR REPLACE INTO plug_watermark VALUES (?, ?);

-- Get all ingested batch keys for a plug (for pruning)
ingestedKeys:
SELECT batch_key FROM ingested_batch WHERE plug = ?;

-- Get all unreadable batch keys for a plug (for pruning)
unreadableKeys:
SELECT batch_key FROM unreadable_batch WHERE plug = ?;

-- Delete a specific ingested batch entry
deleteIngested:
DELETE FROM ingested_batch WHERE plug = ? AND batch_key = ?;

-- Delete a specific unreadable batch entry
deleteUnreadable:
DELETE FROM unreadable_batch WHERE plug = ? AND batch_key = ?;

-- A publish not yet seen in the plug's listing (decision 0077). previous_hlc is the watermark
-- before it (sign-flipped, NULL for none), restored if the object never shows up.
CREATE TABLE unconfirmed_publish (
    plug TEXT NOT NULL,
    batch_key TEXT NOT NULL,
    previous_hlc INTEGER,
    misses INTEGER NOT NULL,
    PRIMARY KEY (plug, batch_key)
) WITHOUT ROWID;

clearWatermark:
DELETE FROM plug_watermark WHERE plug = ?;

insertUnconfirmed:
INSERT OR REPLACE INTO unconfirmed_publish VALUES (?, ?, ?, 0);

unconfirmed:
SELECT batch_key, previous_hlc, misses FROM unconfirmed_publish WHERE plug = ?;

bumpMisses:
UPDATE unconfirmed_publish SET misses = misses + 1 WHERE plug = ? AND batch_key = ?;

deleteUnconfirmed:
DELETE FROM unconfirmed_publish WHERE plug = ? AND batch_key = ?;
