<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only pairing scans; the app installs and works without a camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!--
        Document providers (e.g. Dropbox) must stay visible to us even when the system's
        grant-derived package visibility decays (seen on a OnePlus/Android 16 device: the
        persisted URI grant survived but com.dropbox.android became invisible, so every
        SAF query silently returned an empty folder). Declaring the provider intent keeps
        every installed document provider statically queryable.
    -->
    <queries>
        <intent>
            <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
        </intent>
    </queries>

    <application
        android:name=".TodoApplication"
        android:allowBackup="false"
        android:label="msuite ToDo"
        android:theme="@style/Theme.Todo">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
